# ============================================================
# EVE-COOK .gitignore
# ------------------------------------------------------------
# 作用：告诉 Git 哪些文件 / 目录不需要纳入版本管理。
# 小白理解：虚拟环境、缓存、打包产物都是"自动生成"的东西，
#          体积大且每台机器不同，不应上传到 GitHub。
# ============================================================

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*$py.class

# ---------- 虚拟环境（体积大，禁止提交） ----------
venv/
.venv/
env/
ENV/

# ---------- 打包产物（PyInstaller 输出） ----------
build/
dist/
*.spec
*.exe

# ---------- 运行时生成的数据 ----------
*.log
logs/
*.db
*.sqlite
*.sqlite3
*.pickle
*.pkl

# ---------- 用户本地配置（含个人路径，不提交） ----------
data/config/*.json
config.json

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
